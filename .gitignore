# -------------------------------------------------------------------
# 1. Dependency / Build / Runtime Files
# -------------------------------------------------------------------

# Node.js 패키지 종속성 폴더 (대용량 파일이 수천개 존재)
node_modules
# npm 로그 파일
npm-debug.log
npm-debug.log*
yarn-error.log
yarn-debug.log*
pnpm-debug.log*
.eslintcache

# 빌드 및 배포 관련 폴더
# 프로젝트를 컴파일하거나 배포할 때 생성되는 폴더
dist/
dist-firefox/
dist-prod/
dist-safari/
dist-whale/
dist-landing/
dist-feed-landing/
coverage/
build/
# `src/platform/build` is canonical source, not generated output.
!src/platform/build/
!src/platform/build/releaseCapabilities.js
!src/platform/build/runtimeBuildInfo.js
out/
temp/

# -------------------------------------------------------------------
# 2. OS 및 IDE 관련 파일 (VS Code 포함)
# -------------------------------------------------------------------

# macOS 시스템 파일
.DS_Store

# Windows Thumbs.db
Thumbs.db

# VS Code 설정 및 캐시 폴더
.vscode/
.idea/
*.swp
*.swo
*~

# -------------------------------------------------------------------
# 3. 민감한 정보 및 로그 파일
# -------------------------------------------------------------------

# 환경 변수 파일 (비밀번호, API 키 등 민감 정보 포함 가능성)
.env
.env.*
env.local

# 로그 파일
*.log

# -------------------------------------------------------------------
# 4. Git 자체 관련 파일 (Git이 생성하고 관리하는 파일)
# -------------------------------------------------------------------

# Git 자체 무시 파일 (보통 필요 없지만 안전을 위해 포함)
.git/
.gitattributes

# -------------------------------------------------------------------
# 5. 확장 프로그램 관련 임시 파일
# -------------------------------------------------------------------
# 크롬 확장 프로그램 개발 시 생성될 수 있는 임시 파일이나 폴더가 있다면 추가
# 예시: Chrome의 개발자 도구가 생성하는 파일
.tmp
.tmp-latent-inventory.json
.cache/
.artifacts/

